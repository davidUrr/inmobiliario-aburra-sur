{
  "name": "CCAS Inteligencia Inmobiliaria",
  "dataColors": [
    "#1F6FD1",
    "#E8743B",
    "#0FA38C",
    "#D99A00",
    "#C2508F",
    "#6A5ACD",
    "#8C99A6",
    "#0B4F9E",
    "#6FA6E4",
    "#A9CBF0"
  ],
  "foreground": "#202A32",
  "foregroundNeutralSecondary": "#53616E",
  "foregroundNeutralTertiary": "#6B7B8A",
  "background": "#FFFFFF",
  "backgroundLight": "#EEF4FA",
  "backgroundNeutral": "#DEE7EF",
  "tableAccent": "#004FA3",
  "hyperlink": "#004FA3",
  "good": "#18794E",
  "neutral": "#8A5A00",
  "bad": "#B42318",
  "maximum": "#0B4F9E",
  "center": "#6FA6E4",
  "minimum": "#D6E6F8",
  "null": "#C7D4DF",
  "textClasses": {
    "title": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 12,
      "color": "#202A32"
    },
    "header": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 12,
      "color": "#202A32"
    },
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 10,
      "color": "#53616E"
    },
    "callout": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 28,
      "color": "#202A32"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#DEE7EF"
              }
            },
            "radius": 10
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#202A32"
              }
            },
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 12,
            "alignment": "left"
          }
        ],
        "padding": [
          {
            "top": 12,
            "bottom": 12,
            "left": 14,
            "right": 14
          }
        ],
        "categoryAxis": [
          {
            "gridlineColor": {
              "solid": {
                "color": "#E6EDF3"
              }
            },
            "labelColor": {
              "solid": {
                "color": "#53616E"
              }
            }
          }
        ],
        "valueAxis": [
          {
            "gridlineColor": {
              "solid": {
                "color": "#E6EDF3"
              }
            },
            "labelColor": {
              "solid": {
                "color": "#6B7B8A"
              }
            }
          }
        ],
        "legend": [
          {
            "labelColor": {
              "solid": {
                "color": "#53616E"
              }
            },
            "fontSize": 9
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#EEF4FA"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#EEF4FA"
              }
            }
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#202A32"
              }
            },
            "fontSize": 26,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "categoryLabels": [
          {
            "color": {
              "solid": {
                "color": "#6B7B8A"
              }
            },
            "fontSize": 9
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#004FA3"
              }
            },
            "radius": 10
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "items": [
          {
            "fontColor": {
              "solid": {
                "color": "#202A32"
              }
            }
          }
        ],
        "header": [
          {
            "fontColor": {
              "solid": {
                "color": "#6B7B8A"
              }
            },
            "fontSize": 9
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColor": {
              "solid": {
                "color": "#004FA3"
              }
            }
          }
        ],
        "values": [
          {
            "fontColorPrimary": {
              "solid": {
                "color": "#202A32"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#F6F9FC"
              }
            }
          }
        ]
      }
    },
    "textbox": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ]
      }
    },
    "image": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ]
      }
    },
    "shape": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ]
      }
    }
  }
}